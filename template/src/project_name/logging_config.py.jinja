"""Logging configuration for {{ project_name }}."""

from __future__ import annotations

import logging

DEFAULT_FORMAT = "%(asctime)s %(levelname)-8s %(name)s: %(message)s"


def configure_logging(level: int = logging.INFO) -> None:
    """Configure root logging with a standard format.

    Safe to call more than once; ``force=True`` resets existing handlers so
    the format is applied consistently.
    """
    logging.basicConfig(level=level, format=DEFAULT_FORMAT, force=True)
