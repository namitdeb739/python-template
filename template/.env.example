# Copy this file to .env and fill in your values
# cp .env.example .env
#
# Values here are read by src/<package>/config.py via python-dotenv.

# Application config (override Config defaults)
# DATA_DIR=data
# OUTPUT_DIR=output
# SEED=42

# Database (uncomment if using the db feature)
# DATABASE_URL=sqlite:///./app.db

# Experiment tracking (uncomment for your tracker)
# WANDB_API_KEY=your-key-here
# MLFLOW_TRACKING_URI=http://localhost:5000

# Cloud storage (uncomment as needed)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# GCS_BUCKET=

# HuggingFace (uncomment if using)
# HF_TOKEN=your-token-here

# DVC remote (uncomment if using cloud DVC storage)
# DVC_REMOTE_URL=s3://your-bucket/dvc-store
