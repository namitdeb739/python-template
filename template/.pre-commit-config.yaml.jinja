repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v5.0.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-yaml
      - id: check-toml
      - id: check-merge-conflict
      # uv.lock legitimately exceeds the 500 KB default on dependency-heavy
      # projects and has to be committed, so exempt it by name rather than
      # raising the limit for everything.
      - id: check-added-large-files
        exclude: ^uv\.lock$
      - id: detect-private-key

  # Run via uv so these hooks use the project's own pinned ruff/mypy and can
  # see its dependencies. Isolated pre-commit envs drift from pyproject.toml
  # (a pinned ruff eventually cannot parse a newer target-version) and lack
  # typer/pytest, which makes mypy --strict reject every decorated function.
  - repo: local
    hooks:
      - id: ruff
        name: ruff
        entry: uv run ruff check --fix
        language: system
        types_or: [python, pyi]
      - id: ruff-format
        name: ruff-format
        entry: uv run ruff format
        language: system
        types_or: [python, pyi]
{%- if use_typecheck %}
      - id: mypy
        name: mypy
        entry: uv run mypy --config-file=pyproject.toml src/ tests/
        language: system
        pass_filenames: false
{%- endif %}

  - repo: https://github.com/commitizen-tools/commitizen
    rev: v4.6.0
    hooks:
      - id: commitizen
        stages: [commit-msg]
